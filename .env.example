# -------------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (Configure in Render Dashboard)
# -------------------------------------------------------------
# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/LostandFound?retryWrites=true&w=majority

# Backend Port (Render sets this automatically; 5000 for local/Docker)
PORT=5000

# Secret Key for JWT Signing
JWT_SECRET=your_jwt_secret_key_here

# Allowed Frontend Origin for CORS (e.g., your Vercel deployment URL)
CLIENT_URL=https://your-frontend-project.vercel.app

# -------------------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (Configure in Vercel Dashboard)
# -------------------------------------------------------------
# Backend API Base URL (Point to your live Render backend URL)
VITE_API_URL=https://your-backend-service.onrender.com

# -------------------------------------------------------------
# DOCKER COMPOSE LOCAL PORT MAPPINGS (Experiment 9)
# -------------------------------------------------------------
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
